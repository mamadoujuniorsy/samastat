# Adresse de l'API SamaStat vue depuis le téléphone.
# Émulateur Android : http://10.0.2.2:3001
# Simulateur iOS   : http://localhost:3001
# Appareil réel    : http://<IP LAN du poste>:3001 (ex. http://192.168.1.20:3001)
EXPO_PUBLIC_API_URL=http://10.0.2.2:3001

