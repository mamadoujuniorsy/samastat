# --- Backend ---
PORT=3001
DATABASE_URL=postgres://samastat:samastat@localhost:5440/samastat
REDIS_URL=redis://localhost:6390

# Clé API Anthropic (ne jamais committer la vraie valeur)
ANTHROPIC_API_KEY=
# Modèle principal (Anthropic) pour la compréhension de la question et la formulation de la réponse
SAMASTAT_MODEL=claude-opus-5

# Repli si Anthropic est absent ou indisponible : API compatible OpenAI avec appel d'outils.
# Groq par défaut (clé gratuite sur console.groq.com). Gemini, Mistral, OpenRouter ou Ollama
# fonctionnent aussi en changeant l'URL de base et le modèle.
GROQ_API_KEY=
# Même clé : repli du modèle de langage ET transcription vocale (Whisper, wolof + français).
# SAMASTAT_FALLBACK_PROVIDER=groq
# SAMASTAT_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
# Le modèle Groq llama-3.3-70b-versatile a été retiré du plan développeur en août 2026.
# SAMASTAT_FALLBACK_MODEL=openai/gpt-oss-120b

# Embeddings locaux (transformers.js). Dossier de cache du modèle et nom du modèle.
# SAMASTAT_MODELS_DIR=./.models
# SAMASTAT_EMBEDDING_MODEL=Xenova/multilingual-e5-small

# Services wolof locaux (modèles Hugging Face, licence CC BY-NC 4.0, voir docs/wolof.md)
# ASR Wolof local prioritaire ; le service asr Docker charge Kiriku au premier usage.
# HUGGINGFACE_HUB_TOKEN peut être nécessaire si le dépôt du modèle est gated.
# SAMASTAT_LOCAL_ASR_URL=http://asr:8000
# SAMASTAT_ASR_MODEL=AIHubSN/kiriku-ASR
# HUGGINGFACE_HUB_TOKEN=
# 1 = traduction wolof <-> français (NLLB-200, ~1 Go téléchargé au premier usage)
SAMASTAT_WOLOF_TRANSLATION=0
# 1 = voix wolof (VITS MMS adapté, ~115 Mo, expérimental)
SAMASTAT_WOLOF_TTS=0
# Optional: use Soynade Oolel Voices instead of the experimental local TTS.
# SOYNADE_API_KEY=
# SOYNADE_TTS_URL=https://api.soynade.ai/v1/text-to-speech

# Secret de signature des sessions du personnel ANSD (chaîne longue aléatoire).
SAMASTAT_AUTH_SECRET=
# Compte administrateur initial facultatif : créé au premier démarrage de l'API si absent.
# Ces valeurs ne sont jamais réécrites dans la base si le compte existe déjà.
SAMASTAT_BOOTSTRAP_ADMIN_EMAIL=
SAMASTAT_BOOTSTRAP_ADMIN_NAME=
SAMASTAT_BOOTSTRAP_ADMIN_PASSWORD=

# Origine autorisée pour le frontend web (CORS)
FRONTEND_ORIGIN=http://localhost:3000

# --- Canal WhatsApp (API Cloud Meta), facultatif : inactif tant que vide ---
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# WHATSAPP_API_VERSION=v21.0

# --- Canal SMS (Africa's Talking), facultatif : inactif tant que vide ---
SMS_AT_USERNAME=
SMS_AT_API_KEY=
SMS_AT_SENDER_ID=
# SMS_AT_BASE_URL=https://api.africastalking.com

# --- Frontend web ---
# Adresse de l'API utilisée par le relais serveur Next.js (API_URL prime sur NEXT_PUBLIC_API_URL)
NEXT_PUBLIC_API_URL=http://localhost:3001
# API_URL=http://api:3001
